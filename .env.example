# Test Environment Configuration
# Copy this file to .env and update with your actual credentials

# CasaOS Server Configuration
CASAOS_SERVER_URL=http://192.168.1.231
CASAOS_USERNAME=your_casaos_username
CASAOS_PASSWORD=your_casaos_password

# Jellyfin Configuration  
JELLYFIN_USERNAME=your_jellyfin_username
JELLYFIN_PASSWORD=your_jellyfin_password

# JellyStat Configuration
JELLYSTAT_USERNAME=your_jellystat_username  
JELLYSTAT_PASSWORD=your_jellystat_password

# Security Notes:
# 1. Never commit .env files to version control
# 2. Add .env to your .gitignore file
# 3. Use strong, unique passwords for each service
# 4. Consider using environment-specific credentials for CI/CD